// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

enum TripStatus {
  PLANNING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum ActivityStatus {
  PLANNED
  CONFIRMED
  COMPLETED
  CANCELLED
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String
  trips        Trip[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Trip {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String            @db.Uuid
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String            @db.VarChar(120)
  description      String?           @db.Text
  startDate        DateTime          @db.Date
  endDate          DateTime          @db.Date
  status           TripStatus        @default(PLANNING)
  currency         String            @db.VarChar(3)
  budgetLimit      Decimal?          @db.Decimal(12, 2)
  tripDestinations TripDestination[]
  activities       Activity[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId, startDate])
  @@map("trips")
}

model Destination {
  id               String            @id @default(uuid()) @db.Uuid
  providerId       String            @unique @db.VarChar(32)
  name             String            @db.VarChar(200)
  country          String?           @db.VarChar(120)
  countryCode      String?           @db.VarChar(2)
  region           String?           @db.VarChar(160)
  latitude         Float             @db.DoublePrecision
  longitude        Float             @db.DoublePrecision
  timezone         String?           @db.VarChar(80)
  tripDestinations TripDestination[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("destinations")
}

model TripDestination {
  id            String      @id @default(uuid()) @db.Uuid
  tripId        String      @db.Uuid
  trip          Trip        @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destinationId String      @db.Uuid
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  position      Int
  arrivalDate   DateTime?   @db.Date
  departureDate DateTime?   @db.Date
  notes         String?     @db.Text
  activities    Activity[]

  @@unique([tripId, position])
  @@index([destinationId])
  @@map("trip_destinations")
}

model Activity {
  id                String           @id @default(uuid()) @db.Uuid
  tripId            String           @db.Uuid
  trip              Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripDestinationId String?          @db.Uuid
  tripDestination   TripDestination? @relation(fields: [tripDestinationId], references: [id], onDelete: SetNull)
  title             String           @db.VarChar(160)
  description       String?          @db.Text
  startsAt          DateTime         @db.Timestamptz(3)
  endsAt            DateTime?        @db.Timestamptz(3)
  locationName      String?          @db.VarChar(200)
  status            ActivityStatus   @default(PLANNED)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([tripId, startsAt])
  @@index([tripDestinationId])
  @@map("activities")
}
